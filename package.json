{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@lambdasolver2/opencode-effect-harness",
  "version": "0.2.0-alpha.1",
  "description": "OpenCode v2 plugin: Effect v4 skill-gate enforcement, verification + critic, compound workflows.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./tui": {
      "import": "./src/tui.tsx"
    }
  },
  "files": [
    "dist",
    "packages/module-typescript/assets",
    "packages/module-bend/assets",
    "src/tui.tsx",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdasolver2/opencode-effect-harness.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "opencode": ">=1.17.1"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/index.ts --outdir ./dist --target bun --external @opencode-ai/plugin --external effect --external @ast-grep/napi --external @effect/platform-node --external @effect/sql-sqlite-node --external @opencode-ai/client --external @opencode-ai/schema",
    "prepublishOnly": "bun run test && bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit || tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "typecheck:tsgo": "bunx tsgo --noEmit"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.3",
    "@effect/platform-node": "4.0.0-rc.110",
    "@effect/sql-sqlite-node": "4.0.0-rc.110",
    "@opencode-ai/client": "0.0.0-beta-17898",
    "@opencode-ai/plugin": "0.0.0-beta-17898",
    "@opencode-ai/schema": "0.0.0-beta-17898",
    "@types/diff": "^8.0.0",
    "diff": "^9.0.0",
    "effect": "4.0.0-rc.110",
    "pdfjs-dist": "^6.3.289",
    "picomatch": "^4.0.4",
    "solid-js": "^1.9.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/theme": "0.0.0-beta-17898",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.5",
    "@effect/vitest": "4.0.0-rc.110",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7",
    "@typescript/native-preview": "^7.0.0-dev",
    "@types/node": "^22.0.0"
  },
  "catalog": {
    "@ast-grep/napi": "^0.42.3",
    "@effect/platform-node": "4.0.0-rc.110",
    "@effect/vitest": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110"
  },
  "overrides": {
    "effect": "4.0.0-rc.110"
  }
}
