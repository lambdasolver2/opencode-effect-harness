{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "opencode-effect-harness",
  "version": "0.2.0-alpha.1",
  "description": "OpenCode v2 plugin: Effect v4 skill-gate enforcement, verification + critic, compound workflows.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "opencode-effect-harness": "./src/companion/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./companion": "./src/companion/cli.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit || tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "typecheck:tsgo": "bunx tsgo --noEmit"
  },
  "dependencies": {
    "@ast-grep/napi": "catalog:",
    "@effect/platform-node": "catalog:",
    "@opencode-ai/client": "0.0.0-beta-17898",
    "@opencode-ai/plugin": "0.0.0-beta-17898",
    "@opencode-ai/schema": "0.0.0-beta-17898",
    "@opencode-effect-harness/module-bend": "workspace:*",
    "@opencode-effect-harness/module-typescript": "workspace:*",
    "@types/diff": "^8.0.0",
    "diff": "^9.0.0",
    "effect": "catalog:",
    "opencode-compound-kit": "workspace:*",
    "opencode-harness-kit": "workspace:*",
    "opencode-harness-shared": "workspace:*",
    "opencode-verify-kit": "workspace:*",
    "picomatch": "^4.0.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.42.3",
    "@effect/tsgo": "^0.36.5",
    "@effect/vitest": "4.0.0-rc.110",
    "@opencode-ai/plugin": "0.0.0-beta-17898",
    "@opencode-ai/schema": "0.0.0-beta-17898",
    "@types/bun": "^1.3.14",
    "effect": "4.0.0-rc.110",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "@effect/platform-node": "4.0.0-rc.110",
    "@types/node": "^22.0.0"
  },
  "catalog": {
    "@ast-grep/napi": "^0.42.3",
    "@effect/platform-node": "4.0.0-rc.110",
    "@effect/vitest": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110"
  },
  "overrides": {
    "effect": "4.0.0-rc.110"
  }
}
