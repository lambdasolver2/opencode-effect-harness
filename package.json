{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@lambdasolver2/opencode-effect-harness",
  "version": "0.2.0-alpha.1",
  "description": "OpenCode v2 plugin: Effect v4 skill-gate enforcement, verification + critic, compound workflows.",
  "keywords": ["effect", "opencode", "opencode-plugin", "tui", "verification"],
  "homepage": "https://github.com/lambdasolver2/opencode-effect-harness",
  "bugs": "https://github.com/lambdasolver2/opencode-effect-harness/issues",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "packages/module-typescript/assets",
    "packages/module-bend/assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdasolver2/opencode-effect-harness.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": ">=1.17.1"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun ./scripts/build.ts .",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit || tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "typecheck:tsgo": "bunx tsgo --noEmit"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.42.3",
    "@effect/platform-node": "4.0.0-rc.110",
    "@effect/sql-sqlite-node": "4.0.0-rc.110",
    "@opencode-ai/client": "0.0.0-beta-17898",
    "@opencode-ai/plugin": "0.0.0-beta-17898",
    "@opencode-ai/schema": "0.0.0-beta-17898",
    "@types/diff": "^8.0.0",
    "diff": "^9.0.0",
    "effect": "4.0.0-rc.110",
    "pdfjs-dist": "^6.3.289",
    "picomatch": "^4.0.4",
    "solid-js": "^1.9.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/theme": "0.0.0-beta-17898",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@effect/tsgo": "^0.36.5",
    "@effect/vitest": "4.0.0-rc.110",
    "@opentui/solid": "^0.4.5",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7",
    "@typescript/native-preview": "^7.0.0-dev",
    "@types/node": "^22.0.0"
  },
  "catalog": {
    "@ast-grep/napi": "^0.42.3",
    "@effect/platform-node": "4.0.0-rc.110",
    "@effect/vitest": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110"
  },
  "overrides": {
    "effect": "4.0.0-rc.110"
  }
}
