{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "incremental": true,
    "lib": [
      "ESNext"
    ],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "opencode-harness-kit": ["./packages/harness-kit/src/index.ts"],
      "opencode-harness-kit/*": ["./packages/harness-kit/src/*"],
      "opencode-harness-shared": ["./packages/shared/src/index.ts"],
      "opencode-harness-shared/*": ["./packages/shared/src/*"],
      "opencode-verify-kit": ["./packages/verify-kit/src/index.ts"],
      "opencode-verify-kit/*": ["./packages/verify-kit/src/*"],
      "opencode-compound-kit": ["./packages/compound-kit/src/index.ts"],
      "opencode-compound-kit/*": ["./packages/compound-kit/src/*"],
      "opencode-bench-store": ["./packages/bench-store/src/index.ts"],
      "opencode-bench-store/*": ["./packages/bench-store/src/*"],
      "@opencode-effect-harness/module-typescript": ["./packages/module-typescript/src/index.ts"],
      "@opencode-effect-harness/module-typescript/*": ["./packages/module-typescript/src/*"],
      "@opencode-effect-harness/module-bend": ["./packages/module-bend/src/index.ts"],
      "@opencode-effect-harness/module-bend/*": ["./packages/module-bend/src/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src",
    "src",
    "packages/*/test",
    "test",
    "packages/*/scripts",
    "scripts",
    "modules/**/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
